[
 {
  "i": 0,
  "t": 0.1,
  "metin": "İki leopar saldırıyor."
 },
 {
  "i": 1,
  "t": 1.96,
  "metin": "Kaçan leoparlar oluyor."
 },
 {
  "i": 2,
  "t": 3.36,
  "metin": "Bir kediden büyük"
 },
 {
  "i": 3,
  "t": 4.26,
  "metin": "değil."
 },
 {
  "i": 4,
  "t": 4.9,
  "metin": "Adı bal porsuğu."
 },
 {
  "i": 5,
  "t": 6.08,
  "metin": "Aslan sürüsü etrafını"
 },
 {
  "i": 6,
  "t": 7.34,
  "metin": "sarıyor, o aldırmadan"
 },
 {
  "i": 7,
  "t": 8.64,
  "metin": "yürüyor."
 },
 {
  "i": 8,
  "t": 9.3,
  "metin": "Adını en sevdiği"
 },
 {
  "i": 9,
  "t": 10.34,
  "metin": "yemekten alıyor:"
 },
 {
  "i": 10,
  "t": 11.26,
  "metin": "Bal."
 },
 {
  "i": 11,
  "t": 11.92,
  "metin": "Binlerce arının arasına"
 },
 {
  "i": 12,
  "t": 13.32,
  "metin": "dalıp peteği söküyor."
 },
 {
  "i": 13,
  "t": 14.72,
  "metin": "Ama asıl silahı"
 },
 {
  "i": 14,
  "t": 15.66,
  "metin": "dişleri değil, derisi."
 },
 {
  "i": 15,
  "t": 17.62,
  "metin": "Derisi hem çok"
 },
 {
  "i": 16,
  "t": 18.5,
  "metin": "kalın hem de"
 },
 {
  "i": 17,
  "t": 19.38,
  "metin": "bol."
 },
 {
  "i": 18,
  "t": 20.14,
  "metin": "Ensesinden yakalanınca deri"
 },
 {
  "i": 19,
  "t": 21.58,
  "metin": "dönüyor."
 },
 {
  "i": 20,
  "t": 22.24,
  "metin": "O saldıranı ısırıyor."
 },
 {
  "i": 21,
  "t": 24.04,
  "metin": "Kobra da durduramıyor."
 },
 {
  "i": 22,
  "t": 25.54,
  "metin": "Zehir onu öldürmüyor."
 },
 {
  "i": 23,
  "t": 26.84,
  "metin": "Birkaç saat bayıltıyor."
 },
 {
  "i": 24,
  "t": 28.34,
  "metin": "Uyanıp yılanı yiyor."
 },
 {
  "i": 25,
  "t": 29.92,
  "metin": "En korkusuz hayvan"
 },
 {
  "i": 26,
  "t": 31.04,
  "metin": "unvanı boşuna verilmemiş."
 },
 {
  "i": 27,
  "t": 32.66,
  "metin": "Bal porsuğu mu"
 },
 {
  "i": 28,
  "t": 33.38,
  "metin": "kazanır, sırtlan mı?"
 },
 {
  "i": 29,
  "t": 35.02,
  "metin": "Yorumlara yaz."
 }
]