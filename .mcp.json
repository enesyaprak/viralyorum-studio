{
  "mcpServers": {
    "pexels": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "pexels-mcp-server"],
      "env": {
        "PEXELS_API_KEY": "${PEXELS_API_KEY}"
      }
    },
    "pixabay": {
      "command": "npx.cmd",
      "args": ["-y", "pixabay-mcp@latest"],
      "env": {
        "PIXABAY_API_KEY": "${PIXABAY_API_KEY}"
      }
    }
  }
}
