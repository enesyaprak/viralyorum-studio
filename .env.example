# Bu dosyayi ".env" olarak kopyala ve anahtarlari doldur. .env git'e GIRMEZ.
#
# ONEMLI: .mcp.json bu degiskenleri ${PEXELS_API_KEY} seklinde okur, yani MCP
# server'lari calissin diye bunlarin ORTAM DEGISKENI olarak da tanimli olmasi gerekir:
#   setx PEXELS_API_KEY "..."        (PowerShell, kalici - yeni terminal gerekir)
#   setx PIXABAY_API_KEY "..."

# Pexels Videos - ucretsiz, 200 istek/saat, ticari kullanim serbest, atif gerekmez
# Anahtar: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay Videos - ucretsiz, ikinci kaynak
# Anahtar: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ElevenLabs - VO uretimi (TTS) + VO transkripti (Scribe, karaoke altyazi zamanlari)
# bluemedya-video-editor/.env icinde zaten var, oradan kopyalayabilirsin
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
